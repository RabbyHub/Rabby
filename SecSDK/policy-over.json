{
  "@dnd-kit/core": {
    "global": {
      "allow": {
        "scrollX": "r",
        "scrollY": "r"
      }
    }
  },
  "@dnd-kit/core > @dnd-kit/utilities": {
    "global": {
      "allow": {
        "Document": "r",
        "HTMLElement": "r",
        "SVGElement": "r"
      }
    }
  },
  "@dnd-kit/sortable > @dnd-kit/utilities": {
    "global": {
      "allow": {
        "Document": "r",
        "HTMLElement": "r",
        "SVGElement": "r"
      }
    }
  },
  "@dnd-kit/utilities": {
    "global": {
      "disallow": ["Document", "HTMLElement", "SVGElement"]
    }
  },
  "@ethersproject/random": {
    "global": {
      "allow": {
        "crypto": "r"
      }
    }
  },
  "@imkey/web3-provider": {
    "global": {
      "disallow": ["document", "localStorage"],
      "allow": {
        "performance": "r",
        "JS_SHA3_NO_WINDOW": "r",
        "JS_SHA3_NO_NODE_JS": "r",
        "JS_SHA3_NO_COMMON_JS": "r",
        "JS_SHA3_NO_ARRAY_BUFFER": "r",
        "JS_SHA3_NO_ARRAY_BUFFER_IS_VIEW": "r",
        "TYPED_ARRAY_SUPPORT": "r",
        "__importDefault": "r",
        "__awaiter": "r",
        "__generator": "r",
        "__createBinding": "r",
        "__exportStar": "r",
        "__setModuleDefault": "r",
        "__importStar": "r",
        "__read": "r",
        "fetch": "r",
        "ReadableStream": "r",
        "location": "r",
        "VBArray": "r",
        "__extends": "r",
        "__assign": "r"
      }
    }
  },
  "@ledgerhq/device-signer-kit-ethereum > ethers": {
    "global": {
      "disallow": ["msCrypto"],
      "allow": {
        "crypto": "r"
      }
    }
  },
  "@metamask/post-message-stream": {
    "enable": false
  },
  "@onekeyfe/hd-web-sdk": {
    "global": {
      "allow": {
        "$$onekeyAppStorage": "r",
        "__core-js_shared__": "r",
        "_": "rw",
        "dcodeIO": "r",
        "Long": "r"
      }
    }
  },
  "@opensea/seaport-js > ethers": {
    "global": {
      "disallow": ["WebSocket"],
      "allow": {
        "crypto": "r"
      }
    }
  },
  "@rabby-wallet/hyperliquid-sdk": {
    "global": {
      "allow": {
        "atob": "r",
        "Buffer": "r",
        "addEventListener": "r",
        "removeEventListener": "r"
      }
    }
  },
  "@rabby-wallet/page-provider": {
    "global": {
      "allow": {
        "rabbyWalletRouter": "rw"
      }
    }
  },
  "@rabby-wallet/rabby-swap": {
    "global": {
      "disallow": ["navigator"]
    }
  },
  "@rabby-wallet/wc-socket-transport": {
    "global": {
      "allow": {
        "WebSocket": "r"
      }
    }
  },
  "@sentry/core": {
    "enable": false,
    "global": {
      "allow": {
        "__SENTRY__": "rw",
        "SENTRY_RELEASE": "r",
        "SENTRY_SDK_SOURCE": "r",
        "_sentryDebugIds": "r",
        "_debugIds": "r",
        "_sentryModuleMetadata": "r",
        "_sentryWrappedDepth": "rw",
        "__SENTRY_TRACING__": "r",
        "__SENTRY_DEBUG__": "r",
        "__SENTRY_BROWSER_BUNDLE__": "r",
        "document": "r",
        "navigator": "r",
        "location": "r",
        "performance": "r",
        "history": "r",
        "fetch": "rw",
        "XMLHttpRequest": "r",
        "onerror": "rw",
        "onunhandledrejection": "rw",
        "addEventListener": "r",
        "removeEventListener": "r",
        "crypto": "r",
        "msCrypto": "r"
      }
    }
  },
  "@sentry/utils": {
    "enable": false,
    "global": {
      "allow": {
        "performance": "r",
        "__SENTRY__": "rw"
      }
    }
  },
  "@trezor/connect-web": {
    "global": {
      "allow": {
        "addEventListener": "r"
      }
    }
  },
  "@trezor/protobuf > protobufjs": {
    "global": {
      "allow": {
        "process": "r",
        "dcodeIO": "r",
        "Long": "r"
      }
    }
  },
  "ahooks": {
    "global": {
      "allow": {
        "addEventListener": "r",
        "removeEventListener": "r"
      }
    }
  },
  "dexie": {
    "global": {
      "allow": {
        "Blob": "r",
        "File": "r",
        "FileList": "r",
        "FileSystemFileHandle": "r",
        "FileSystemDirectoryHandle": "r",
        "ImageBitmap": "r",
        "ImageData": "r",
        "CryptoKey": "r",
        "Float8Array": "r",
        "Int64Array": "r",
        "Uint64Array": "r",
        "IDBKeyRange": "r",
        "Promise": "rw"
      }
    }
  },
  "ethers": {
    "global": {
      "allow": {
        "_ethers": "rw"
      }
    }
  },
  "gridplus-sdk > ethers": {
    "global": {
      "disallow": ["WebSocket"],
      "allow": {
        "crypto": "r"
      }
    }
  },
  "gridplus-sdk > js-sha3": {
    "global": {
      "allow": {
        "JS_SHA3_NO_COMMON_JS": "r",
        "JS_SHA3_NO_ARRAY_BUFFER": "r",
        "JS_SHA3_NO_NODE_JS": "r",
        "JS_SHA3_NO_ARRAY_BUFFER_IS_VIEW": "r",
        "JS_SHA3_NO_WINDOW": "r"
      }
    }
  },
  "js-md5": {
    "global": {
      "allow": {
        "JS_MD5_NO_COMMON_JS": "r",
        "JS_MD5_NO_ARRAY_BUFFER": "r",
        "JS_MD5_NO_NODE_JS": "r",
        "JS_MD5_NO_ARRAY_BUFFER_IS_VIEW": "r",
        "JS_MD5_NO_WINDOW": "r"
      }
    }
  },
  "js-sha3": {
    "global": {
      "allow": {
        "JS_SHA3_NO_WINDOW": "r",
        "JS_SHA3_NO_NODE_JS": "r",
        "JS_SHA3_NO_COMMON_JS": "r",
        "JS_SHA3_NO_ARRAY_BUFFER": "r",
        "JS_SHA3_NO_ARRAY_BUFFER_IS_VIEW": "r"
      }
    }
  },
  "jszip": {
    "global": {
      "disallow": [
        "addEventListener",
        "document",
        "importScripts",
        "onmessage",
        "postMessage"
      ],
      "allow": {
        "setImmediate": "rw",
        "clearImmediate": "rw"
      }
    }
  },
  "lodash": {
    "global": {
      "allow": {
        "process": "r",
        "__core-js_shared__": "r",
        "_": "rw",
        "Buffer": "r",
        "clearTimeout": "r",
        "setTimeout": "r"
      }
    }
  },
  "node-fetch": {
    "global": {
      "allow": {
        "fetch": "r",
        "Headers": "r",
        "Request": "r",
        "Response": "r"
      }
    }
  },
  "pbkdf2": {
    "global": {
      "allow": {
        "crypto": "r"
      }
    }
  },
  "protobufjs": {
    "global": {
      "allow": {
        "dcodeIO": "r",
        "Long": "r",
        "process": "r"
      }
    }
  },
  "randombytes": {
    "global": {
      "allow": {
        "crypto": "r"
      }
    }
  },
  "randomfill": {
    "global": {
      "allow": {
        "crypto": "r"
      }
    }
  },
  "rc-align": {
    "global": {
      "allow": {
        "addEventListener": "r",
        "removeEventListener": "r"
      }
    }
  },
  "rc-motion": {
    "global": {
      "allow": {
        "AnimationEvent": "r",
        "TransitionEvent": "r"
      }
    }
  },
  "react-dom": {
    "global": {
      "allow": {
        "HTMLIFrameElement": "r",
        "nodeName": "r"
      }
    }
  },
  "react-router": {
    "global": {
      "allow": {
        "__react_router_build__": "rw"
      }
    }
  },
  "react-virtuoso": {
    "global": {
      "allow": {
        "VIRTUOSO_LOG_LEVEL": "r"
      }
    }
  },
  "resize-observer-polyfill": {
    "global": {
      "allow": {
        "ResizeObserver": "r"
      }
    }
  },
  "ua-parser-js": {
    "global": {
      "allow": {
        "navigator": "r",
        "jQuery": "r",
        "Zepto": "r"
      }
    }
  },
  "util-deprecate": {
    "global": {
      "disallow": ["localStorage"]
    }
  },
  "zod": {
    "global": {
      "allow": {
        "__zod_globalConfig": "rw",
        "__zod_globalRegistry": "rw"
      }
    }
  }
}
