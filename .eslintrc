{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "rules": {
    "quotes": [1, "single", "avoid-escape"],
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.name='useRabbySelector'][arguments.length=1] > ArrowFunctionExpression > :matches(ObjectExpression, ArrayExpression).body",
        "message": "This selector returns a new object or array on every call, so the component re-renders on every store update. Wrap the selector in `useShallow` from 'zustand/react/shallow'."
      },
      {
        "selector": "CallExpression[callee.name='useRabbySelector'][arguments.length=1] > ArrowFunctionExpression > BlockStatement > ReturnStatement > :matches(ObjectExpression, ArrayExpression)",
        "message": "This selector returns a new object or array on every call, so the component re-renders on every store update. Wrap the selector in `useShallow` from 'zustand/react/shallow'."
      },
      {
        "selector": "CallExpression[callee.name='useRabbySelector'] > ArrowFunctionExpression > LogicalExpression > :matches(ObjectExpression, ArrayExpression).right",
        "message": "A `|| []` / `?? {}` fallback in a selector is a new value on every call. Use a constant defined outside the component."
      }
    ],
    "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": [
        "*.test.js",
        "*.test.ts",
        "*.test.tsx",
        "*.spec.js",
        "*.spec.ts",
        "*.spec.tsx"
      ],
      "env": {
        "jest": true
      }
    }
  ]
}
