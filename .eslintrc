{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-you-might-not-need-an-effect/legacy-recommended",
    "plugin:@tanstack/query/recommended",
    "plugin:prettier/recommended"
  ],
  "rules": {
    "quotes": [1, "single", "avoid-escape"],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "styled-components",
            "message": "styled-components was removed; it injects styles at runtime, outside the cascade layers, so they beat every Tailwind class. Use Tailwind classes, or a .module.css for antd internals (AGENTS.md, \"Styling Conventions\")."
          },
          {
            "name": "react-use",
            "importNames": [
              "useCss",
              "useDebounce",
              "useInterval",
              "useMount",
              "useSetState",
              "usePrevious",
              "useClickAway",
              "useScroll",
              "useThrottleFn",
              "useToggle",
              "useMedia",
              "createGlobalState"
            ],
            "message": "useCss injects styles at runtime, outside the cascade layers, so they beat every Tailwind class. Use Tailwind classes, or a .module.css for antd internals (AGENTS.md, \"Styling Conventions\"). The other names are utility hooks that moved to ahooks or src/ui/hooks, whose signatures differ: useDebounce -> ahooks useDebounceEffect or useDebounceFn with an explicit wait (default 1000 ms), or useDebouncedValue from @/ui/hooks/useDebounceValue for a debounced input (skills/rabby-data-fetching/SKILL.md); usePrevious -> usePreviousRender from @/ui/hooks/usePreviousRender (ahooks usePrevious returns the last different value); useMedia -> UI_TYPE from @/constant/ui for popup-vs-tab layouts, or window.matchMedia; createGlobalState -> a zustand store; useThrottleFn -> ahooks useThrottle or useThrottledValueLeading/Trailing; the rest -> the ahooks hook of the same name."
          }
        ],
        "patterns": [
          {
            "group": ["@emotion/*"],
            "message": "Emotion injects styles at runtime, outside the cascade layers, so they beat every Tailwind class. Use Tailwind classes, or a .module.css for antd internals (AGENTS.md, \"Styling Conventions\")."
          },
          {
            "group": ["react-use/lib/useCss", "react-use/esm/useCss"],
            "message": "useCss injects styles at runtime, outside the cascade layers, so they beat every Tailwind class. Use Tailwind classes, or a .module.css for antd internals (AGENTS.md, \"Styling Conventions\")."
          },
          {
            "group": [
              "react-use/lib/useDebounce",
              "react-use/esm/useDebounce",
              "react-use/lib/useInterval",
              "react-use/esm/useInterval",
              "react-use/lib/useMount",
              "react-use/esm/useMount",
              "react-use/lib/useSetState",
              "react-use/esm/useSetState",
              "react-use/lib/usePrevious",
              "react-use/esm/usePrevious",
              "react-use/lib/useClickAway",
              "react-use/esm/useClickAway",
              "react-use/lib/useScroll",
              "react-use/esm/useScroll",
              "react-use/lib/useThrottleFn",
              "react-use/esm/useThrottleFn",
              "react-use/lib/useToggle",
              "react-use/esm/useToggle",
              "react-use/lib/useMedia",
              "react-use/esm/useMedia",
              "react-use/lib/factory/createGlobalState",
              "react-use/esm/factory/createGlobalState"
            ],
            "message": "This utility hook moved to ahooks or src/ui/hooks, whose signatures differ: useDebounce -> ahooks useDebounceEffect or useDebounceFn with an explicit wait (default 1000 ms), or useDebouncedValue from @/ui/hooks/useDebounceValue for a debounced input (skills/rabby-data-fetching/SKILL.md); usePrevious -> usePreviousRender from @/ui/hooks/usePreviousRender (ahooks usePrevious returns the last different value); useMedia -> UI_TYPE from @/constant/ui for popup-vs-tab layouts, or window.matchMedia; createGlobalState -> a zustand store; useThrottleFn -> ahooks useThrottle or useThrottledValueLeading/Trailing; the rest -> the ahooks hook of the same name."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.name=/^(useRabbySelector|use[A-Z]\\w*Store)$/][arguments.length=1] > ArrowFunctionExpression > :matches(ObjectExpression, ArrayExpression).body",
        "message": "This selector returns a new object or array on every call. Wrap it in `useShallow` from 'zustand/react/shallow'. Otherwise useRabbySelector re-renders on every store update, and a plain `create` store hook can loop forever (zustand v5)."
      },
      {
        "selector": "CallExpression[callee.name=/^(useRabbySelector|use[A-Z]\\w*Store)$/][arguments.length=1] > ArrowFunctionExpression > BlockStatement > ReturnStatement > :matches(ObjectExpression, ArrayExpression)",
        "message": "This selector returns a new object or array on every call. Wrap it in `useShallow` from 'zustand/react/shallow'. Otherwise useRabbySelector re-renders on every store update, and a plain `create` store hook can loop forever (zustand v5)."
      },
      {
        "selector": "CallExpression[callee.name=/^(useRabbySelector|use[A-Z]\\w*Store)$/] > ArrowFunctionExpression > LogicalExpression > :matches(ObjectExpression, ArrayExpression).right",
        "message": "A `|| []` / `?? {}` fallback in a selector is a new value on every call. Use a constant defined outside the component."
      }
    ],
    "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": [
        "*.test.js",
        "*.test.ts",
        "*.test.tsx",
        "*.spec.js",
        "*.spec.ts",
        "*.spec.tsx"
      ],
      "env": {
        "jest": true
      }
    }
  ]
}
